# ─────────────────────────────────────────────────────────────────────────────
#  .env.example  –  Template configuration file (safe to commit to GitHub)
#
#  HOW TO SET UP:
#    1. Copy this file and rename it to:  .env
#    2. Replace the placeholder below with your YouTube Data API v3 key.
#    3. The .env file is listed in .gitignore and will NOT be committed to git.
# ─────────────────────────────────────────────────────────────────────────────
YT_API_KEY=YOUR_YOUTUBE_API_KEY_HERE
